{
	"name": "@vdegenne/vite-plugin-css-modules",
	"version": "0.1.14",
	"type": "module",
	"exports": {
		".": {
			"import": "./lib/index.js",
			"types": "./lib/index.d.ts"
		},
		"./css": {
			"types": "./types.d.ts"
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/vdegenne/vite-plugin-css-modules.git"
	},
	"scripts": {
		"build": "wireit"
	},
	"files": [
		"./lib/",
		"./types.d.ts"
	],
	"devDependencies": {
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2",
		"vite": "^8.3.6",
		"wireit": "^0.15.0"
	},
	"wireit": {
		"build": {
			"command": "tsc --pretty",
			"clean": "if-file-deleted",
			"files": [
				"./tsconfig.json",
				"./src"
			],
			"output": [
				"./lib"
			]
		}
	},
	"dependencies": {
		"es-module-lexer": "^3.0.4"
	}
}
